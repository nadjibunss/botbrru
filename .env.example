MONGO_URI=mongodb://mongo:27017
MONGO_DB=shopee_monitor

# Generate:
# python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=GANTI_DENGAN_FERNET_KEY_VALID

# Token master bot dari @BotFather — secret, jangan commit
MASTER_BOT_TOKEN=GANTI_DENGAN_TOKEN_BOT

HOST=0.0.0.0
PORT=8000

# Level log: INFO (default) atau DEBUG untuk diagnosa lebih detail
LOG_LEVEL=INFO

DEFAULT_KEYWORDS=GMP|Rosebrand Kuning|Gulaku Kuning
DEFAULT_AREA=Kab. Bekasi
REQUEST_DELAY_MIN=10
REQUEST_DELAY_MAX=20

# Endpoint resmi/diotorisasi untuk validasi cookie.
# Kosongkan bila belum ada → bot hanya cek format cookie.
SESSION_VALIDATION_URL=

# ── Opsional / lanjutan (punya default, boleh dikosongkan) ──
# Daftar proxy untuk request pencarian Shopee (rotasi otomatis).
# Satu proxy per baris di file ini: http://ip:port atau socks5://ip:port.
PROXY_FILE=/app/proxies.txt
# Proxy tunggal (dipakai hanya bila PROXY_FILE kosong/tidak ada).
PROXY_URL=
# Timeout & retry HTTP client (services.shopee_client)
REQUEST_TIMEOUT=30
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
# Override User-Agent / client-hints bila perlu menyamai browser tertentu
# USER_AGENT=
# SEC_CH_UA=
# SHOPEE_CLIENT_VERSION=
